[Unit]
Description=Amazon Tracker v2
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/amazon-tracker
EnvironmentFile=/opt/amazon-tracker/.env
# --timeout-graceful-shutdown: without it uvicorn waits for every background task before exiting,
# so a restart during a long Amazon fetch hung until systemd SIGKILLed it at 90s - the app was
# unreachable for that minute and a half (6 Oct, the first of four deploys).
ExecStart=/opt/amazon-tracker/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1 --timeout-graceful-shutdown 15
Restart=always
RestartSec=5
MemoryMax=700M
MemoryHigh=500M
# The production copy had drifted to 400M/600M; at 400M a 90-day refresh pinned the app at its
# ceiling (4,669 throttle events in 25 min) and every page took 35-59 s. This file is the source of
# truth: install it with `sudo cp deploy/systemd/tracker.service /etc/systemd/system/ && sudo
# systemctl daemon-reload && sudo systemctl restart tracker`. update-ec2.sh does NOT install it.
OOMPolicy=kill
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
