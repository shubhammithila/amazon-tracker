{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "outDir": "dist",
    "rootDir": ".",

    // The whole reason TypeScript was chosen over plain JS for this port. `e.cartons` printed
    // "100/undefined" on the owner's screen in the Python app because JavaScript renders a
    // missing property rather than complaining; these settings turn that class of defect into a
    // compile error.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // Off deliberately: the parser genuinely reads possibly-absent nodes and handles them, and
    // turning every unused catch binding into an error adds noise without catching a bug.
    "noUnusedLocals": true,
    "noUnusedParameters": false,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
